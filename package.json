{
  "name": "tgcloud-nemotron-bot",
  "version": "1.0.0",
  "description": "Telegram Serverless bot with NVIDIA Nemotron 3.5 Super VL",
  "private": true,
  "scripts": {
    "deploy": "npx tgcloud push",
    "run": "npx tgcloud run",
    "status": "npx tgcloud status",
