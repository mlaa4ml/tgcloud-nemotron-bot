# Ключ API модели NVIDIA Nemotron 3.5 Super VL (получить на https://build.nvidia.com/)
NVIDIA_API_KEY=nvapi-ваш_ключ_здесь

# Базовый URL API NVIDIA (по умолчанию)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Имя модели Nemotron (по умолчанию)
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Telegram ID первого администратора бота (опционально).
# Этот пользователь получает права администратора сразу при первом запуске
# и может добавлять других администраторов через команду /addadmin <tg_id>.
INITIAL_ADMIN_TG_ID=123456789